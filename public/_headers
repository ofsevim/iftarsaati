/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Service-Worker-Allowed: /
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; media-src 'self' https://cdn.islamic.network https://assets.mixkit.co; connect-src 'self' https://api.aladhan.com https://api.alquran.cloud; object-src 'none'; base-uri 'self'

/
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-cache

/index.html
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-cache

/widget*
  Content-Security-Policy: frame-ancestors *

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
